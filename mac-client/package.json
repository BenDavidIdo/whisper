{
  "name": "whisper-flow-mac-client",
  "version": "1.0.0",
  "description": "Mac client for Whisper Flow — hold fn to dictate",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.whisperflow.mac-client",
    "productName": "Whisper Flow",
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false
    },
    "files": ["out/**/*"],
    "extraResources": [
      {
        "from": "server-dist/whisper-server",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "npmRebuild": false
  }
}
